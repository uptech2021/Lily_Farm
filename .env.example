# Firebase Configuration
# Get these values from: Project Settings > General > Your apps > Web app
FIREBASE_API_KEY=YOUR_API_KEY
FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
FIREBASE_APP_ID=YOUR_APP_ID
FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Gmail SMTP newsletter delivery (server-side only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-address@gmail.com
SMTP_APP_PASSWORD=your-16-character-google-app-password
EMAIL_FROM_NAME=Rishi's Lily Farm
EMAIL_FROM_ADDRESS=your-address@gmail.com
EMAIL_TOKEN_SECRET=generate-with-npm-run-email-secret
ORDER_NOTIFICATION_EMAIL=your-order-notification-address@gmail.com
