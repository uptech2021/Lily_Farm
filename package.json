{
  "name": "rishis-lily-farm",
  "version": "1.0.0",
  "description": "Rishi's Lily Farm and Exotic Plants - Collaborative Web Development Project",
  "main": "index.html",
  "scripts": {
    "config": "node scripts/generate-firebase-config.js",
    "prestart": "npm run config",
    "start": "live-server --port=3000 --middleware=scripts/deny-env-middleware.js",
    "build": "npm run config",
    "predev": "npm run config",
    "dev": "live-server --port=3000 --open --middleware=scripts/deny-env-middleware.js"
  },
  "keywords": [
    "lily-farm",
    "exotic-plants",
    "ecommerce",
    "firebase",
    "collaborative"
  ],
  "author": "Rishi's Lily Farm Team",
  "license": "MIT",
  "devDependencies": {
    "live-server": "^1.2.2"
  },
  "dependencies": {
    "firebase": "^10.7.1"
  }
}
